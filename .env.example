# Copy to .env (git-ignored). The OpenRouter key pays for every subject, reader and judge call.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: point the client at a local vLLM server instead of OpenRouter (used on the cluster for Gemma)
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=local
# LOCAL_MODEL=google/gemma-3-27b-it
